# PIPE.ID shared development environment
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=postgresql://postgres:password@localhost:5432/pipe_id
JWT_SECRET=replace-with-at-least-32-random-characters
PASSWORD_RESET_URL=http://127.0.0.1:5173/reset-password
RESET_TOKEN_TTL_MINUTES=30

# Frontend API endpoint (safe to expose to the browser)
VITE_API_URL=http://127.0.0.1:4000/api/v1
